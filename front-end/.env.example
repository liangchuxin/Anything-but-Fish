# Public browser configuration; never put secrets here.
VITE_API_BASE_URL=/api
# Used only by the Vite development proxy.
API_PROXY_TARGET=http://127.0.0.1:8000
# Game requests use MSW in development and builds made with npm run build:demo.
# Set false to use the real API, or true to explicitly enable mocks in any mode.
# VITE_ENABLE_MOCKS=false
VITE_MOCK_SCENARIO=demo
VITE_MOCK_DELAY_MS=250

# Atlas reference only; the frontend does not consume these variables.
# Set the actual database password in ../back-end/.env.
MONGODB_URI=mongodb+srv://username:<db_password>@cluster0.t31u9ju.mongodb.net/
MONGODB_DB_NAME=anything_but_fish
