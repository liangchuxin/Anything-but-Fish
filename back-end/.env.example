# Backend only. Never expose these values through VITE_* variables.
MONGODB_URI=mongodb+srv://username:<db_password>@cluster0.t31u9ju.mongodb.net/
MONGODB_DB_NAME=anything_but_fish
AUTH_SESSION_COOKIE=abf_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
# Generate a private value: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
AUTH_COOKIE_SAME_SITE=lax
# Set to the number of trusted reverse proxies in production; direct local access uses 0.
TRUST_PROXY=0
